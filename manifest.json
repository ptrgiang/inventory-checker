{
  "manifest_version": 3,
  "name": "Amazon Inventory Checker",
  "version": "1.0",
  "description": "Check Amazon inventory for multiple ASINs using the AOD API",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://data.amazon.com/*"
  ],
  "icons": {
    "16":  "assets/icon-16.png",
    "32":  "assets/icon-32.png",
    "48":  "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Inventory Checker",
    "default_icon": {
      "16":  "assets/icon-16.png",
      "32":  "assets/icon-32.png",
      "48":  "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
